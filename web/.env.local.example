# Copy to .env.local and fill in real values. Never commit .env.local.

# Data store — Google Sheets (preferred) or Airtable (legacy)
# DATA_STORE=google_sheets
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# On Vercel: GOOGLE_SERVICE_ACCOUNT_JSON must be the full inline JSON (not a Mac file path).

# Practice import via Google Drive API (required for /import/practice on Vercel).
# Folder ID = the last segment of the Drive URL: https://drive.google.com/drive/folders/FOLDER_ID
# Share "03 Clients Active" (or that folder) with the service account email as Viewer.
# Enable Google Drive API on the same GCP project as the service account.
# AOD_PRACTICE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_CLIENTS_FOLDER_ID=   # alternate name for the same folder ID
# Optional local Mac sync path override (used only when Drive folder ID is unset):
# AOD_PRACTICE_ROOT=

# Airtable (legacy fallback — omit when using Google Sheets)
AIRTABLE_PAT=pat_replace_me
AIRTABLE_BASE_ID=app_replace_me

# Backend URL (local FastAPI or Fly.io production)
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=https://associateondemand-api.fly.dev

# PII tier surfaced to the UI banner (mirrors services/api AOD_PII_TIER)
NEXT_PUBLIC_PII_TIER=0

# --- Supabase Auth (Phase 7) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_replace_me_anon_key
# Server-only (optional admin tooling; not required for sign-in)
SUPABASE_SERVICE_ROLE_KEY=eyJ_replace_me_service_role

# Set true only after Supabase URL + anon key are real
AOD_AUTH_ENABLED=false

# Front door — Google Calendar Appointment Schedule or Cal.com embed URL
# NEXT_PUBLIC_BOOKING_URL=https://calendar.google.com/calendar/appointments/...
# Supabase Dashboard → Authentication → URL configuration:
# Site URL + Redirect URLs must include https://your-domain/auth/callback
# (password reset and magic links use that callback).
