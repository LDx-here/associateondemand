# Copy to `.env` for FastAPI/docker-compose interpolation, or set in your shell.
# Web app secrets belong in `web/.env.local` (see web/.env.local.example).

# --- Data store (Google Sheets preferred; Airtable legacy fallback) ---
# DATA_STORE=google_sheets
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # Vercel: paste full JSON one line
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # local dev alternative

# --- Airtable (legacy; omit when using Google Sheets) ---
AIRTABLE_PAT=pat_replace_me
AIRTABLE_BASE_ID=app_replace_me

# --- Postgres (local docker-compose default; production = Supabase) ---
# Local:
DATABASE_URL=postgresql+psycopg://aod:aod@localhost:5432/aod
# Supabase direct (Alembic migrations only):
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres
# Supabase pooler (Fly.io runtime):
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# --- Redis (local compose; production = Upstash rediss://) ---
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://default:[PASSWORD]@[endpoint].upstash.io:6379

# --- Qdrant (optional; defer pattern features in prod if unset) ---
QDRANT_URL=http://localhost:6333
# QDRANT_URL=https://[cluster].cloud.qdrant.io
# QDRANT_API_KEY=

# --- CORS (comma-separated; include Vercel URL in production) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- PII / anonymization ---
# 0 = description-only / manual approvals for doc agents (default early on)
# 1 = anonymization proxy verified (future flip after Presidio tests pass)
AOD_PII_TIER=0

# --- LLMs (Phase 4+) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-sonnet-4

# --- OCR (Phase 3) ---
OCR_PROVIDER=tesseract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Research APIs (Phase 4+, optional live tiers) ---
MIDPAGE_API_KEY=
FASTCASE_API_KEY=

# --- Uploads ---
UPLOAD_DIR=./data/uploads

# --- Agent / vault paths (Docker sets these automatically) ---
AOD_CONSTITUTION_DIR=./docs/constitution
AOD_BRAIN_ROOT=./brain
PRESIDIO_HEALTH_URL=http://localhost:8080

# --- Naming ---
APP_NAME=AssociateOnDemand API

# --- Supabase (Phase 7: Auth + Postgres for agent_jobs / audit_logs) ---
# Used by Fly.io API (DATABASE_URL above) and documented for web in web/.env.local.example
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  # server only; never commit
