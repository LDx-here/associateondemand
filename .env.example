# Copy to `.env` for FastAPI/docker-compose interpolation, or set in your shell.
# Web app secrets belong in `web/.env.local` (see web/.env.local.example).

# --- Airtable (Phase 1) ---
AIRTABLE_PAT=pat_replace_me
AIRTABLE_BASE_ID=app_replace_me

# --- Core services ---
DATABASE_URL=postgresql+psycopg://aod:aod@localhost:5432/aod
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
ALLOWED_ORIGINS=http://localhost:3000

# --- PII / anonymization ---
# 0 = description-only / manual approvals for doc agents (default early on)
# 1 = anonymization proxy verified (future flip after Presidio tests pass)
AOD_PII_TIER=0

# --- LLMs (Phase 4+) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-sonnet-4

# --- OCR (Phase 3) ---
OCR_PROVIDER=tesseract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Research APIs (Phase 4+) ---
MIDPAGE_API_KEY=
FASTCASE_API_KEY=

# --- Uploads ---
UPLOAD_DIR=./data/uploads

# --- Agent / vault paths (Docker sets these automatically) ---
AOD_CONSTITUTION_DIR=./docs/constitution
AOD_BRAIN_ROOT=./brain
PRESIDIO_HEALTH_URL=http://localhost:8080

# --- Naming ---
APP_NAME=AssociateOnDemand API
