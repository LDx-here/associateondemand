# Database (MySQL required — use docker-compose or TiDB)
DATABASE_URL=mysql://legalos:legalos@localhost:3307/legal_os

# Admin auth (development — replace with Manus OAuth in production)
ADMIN_API_KEY=dev-admin-key-change-me
CRON_SECRET=dev-cron-secret

# LLM (optional — drafting falls back to template output when unset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage (local fallback when S3 not configured)
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Stripe (optional — invoice-after-delivery when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Clio — per LEGAL_BOUNDARIES.md: requires paying subscription + scoped need
# Code ships disabled until all four vars are set
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://localhost:3001/api/clio/callback
CLIO_WEBHOOK_SECRET=

# Server
PORT=3001
NODE_ENV=development
